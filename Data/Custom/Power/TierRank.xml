<!--
============================================================
== AVEmulator
== (C) 2026 AVEmulator
== TierRank.xml
== VIP/prestige Rank system. Players convert specific items into Rank
== Points, then spend those points + currency + a minimum Combat Power
== (see PowerCombat.xml) to advance one Rank at a time. Each Rank grants
== permanent stat bonuses and adds to the player's own Combat Power.
== Loaded by GameServer via BCustomVIPChar::Load().
==
== <TierRank Enable="" Firework="" Notice="" Msg="">
==   Firework   0 = none, 1/2/3 = which server effect plays on rank-up.
==   Notice     0 = none, 1 = notice on this GameServer only,
==              2 = notice on every GameServer, 3 = same as 2 with the
==              server name prefixed.
==   Msg        Rank-up broadcast text. %s = player name, %d = new Rank.
==
== <MessageInfo><Message Index="" Text="" /></MessageInfo>
==   In-game feedback strings, looked up by Index from the C++ code.
==
== <ItemPoint><Item IndexItem="" Level="" ExlOp="" PointVIP="" /></ItemPoint>
==   Items players can convert into Rank Points. Level/ExlOp: 255 = any.
==
== <LevelUpVip><Config .../></LevelUpVip> - one row per Rank tier:
==   LevelVIP             This tier's Rank number.
==   PointVIP             Rank Points required (consumed on rank-up).
==   WC/WP/GP             WCoinC/WCoinP/GoblinPoint cost (all 3 charged).
==   RequireCombatPower   Minimum Combat Power (PowerCombat.xml) needed.
==   TypeOp1-6/ValueOp1-6  Permanent stat bonuses granted at this Rank -
==                         Type is an EFFECT_OPTION-style stat ID, Value
==                         is the amount added.
==   CombatPower           Added to the player's total Combat Power once
==                         this Rank is reached.
==   RewardGensContribution  Gens Contribution points granted once, on
==                         rank-up. 0 = none.
==   RewardBag             EventItemBagManager.xml Bag Index rolled once,
==                         on rank-up. -1 = none.
== Modify only if you know what you're doing!
============================================================
-->
<TierRank Enable="1" Firework="1" Notice="1" Msg="[%s] just upgraded to Rank [%d]">
<MessageInfo>
	<Message Index="0" Text="This feature is currently disabled!" />
	<Message Index="1" Text="The item you selected cannot be converted!" />
	<Message Index="2" Text="You converted [%d] Rank Points!" />
	<Message Index="3" Text="Rank upgraded successfully" />
	<Message Index="4" Text="Not enough currency or Rank Points" />
	<Message Index="5" Text="Action too fast!" />
	<Message Index="6" Text="You have reached the maximum Rank!" />	
	<Message Index="7" Text="Not enough Combat Power" />	
</MessageInfo>	

