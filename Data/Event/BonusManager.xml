		<Value BonusIndex="3" Value0="1000" Value1="1000" Value2="1000" Value3="1000" ItemIndex="7179" ItemLevel="3" MapNumber="-1" MonsterClass="-1" MonsterLevelMin="12" MonsterLevelMax="69" />
	</Bonus>
