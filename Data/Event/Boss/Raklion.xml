		<GameServer Enabled="1" />
	</ServerSettings>
	<Timing AppearanceDelay="5" BossZoneCloseDelay="300" BossZoneOpenDelay="300" />
	<BossEgg Half="5" Max="15" />
	<SelupanSkill Delay="1000" />
	<SelupanPattern Pattern1="80" Pattern2="60" Pattern3="50" Pattern4="40" Pattern5="20" Pattern6="10" />
