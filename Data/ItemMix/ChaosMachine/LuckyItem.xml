<ItemMix Name="LuckyItem">
  <Recipe Enabled="1" RecipeID="68" Type="51" ClientSync="0" Name="Create Lucky Item" PriceType="0" Money="0">
    <Rates AL0="100" AL1="100" AL2="100" AL3="100" />
    <Requirements>
      <!-- La rutina nativa acepta los tickets 13:135 hasta 13:144. -->
      <Item Section="13" Index="135" MinLevel="-1" MaxLevel="-1" Count="1" CountMode="0" Comment="Lucky Item Ticket" />
    </Requirements>
  </Recipe>

  <Recipe Enabled="1" RecipeID="69" Type="52" ClientSync="0" Name="Refine Lucky Item" PriceType="0" Money="0">
    <Rates AL0="-1" AL1="-1" AL2="-1" AL3="-1" />
    <Requirements>
      <!-- El atributo Lucky Item se valida directamente en la rutina nativa. -->
      <Item Section="14" Index="160" MinLevel="-1" MaxLevel="-1" Count="1" CountMode="0" Comment="Refining Stone result reference" />
    </Requirements>
  </Recipe>
</ItemMix>
